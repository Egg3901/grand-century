{
  "name": "grand-century",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "map:history": "node scripts/apply-historical-world.mjs",
    "map:history:check": "node scripts/apply-historical-world.mjs --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --project unit",
    "test:balance": "vitest run --project balance",
    "test:all": "vitest run",
    "test:stability": "vitest run tests/m6.ai.stability.test.ts",
    "season-report": "tsx content/season-report.ts",
    "test:ci": "npm run lint && tsc -b && vitest run && npm run test:e2e:smoke",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/v6-smoke.spec.ts tests/e2e/e6-platform.spec.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "probe:pacing": "PACING=1 vitest run tests/pacing.century.test.ts"
  },
  "dependencies": {
    "@sentry/browser": "^10.67.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
