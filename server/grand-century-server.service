[Unit]
Description=Grand Century multiplayer session server (MP-M1)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/grand-century
Environment=PORT=3412
# systemd has a minimal PATH; node/npm live in /root/.local/bin (tsx needs node too).
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.local/bin/npm run server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
