{
  "expo": {
    "name": "Grand Century",
    "slug": "grand-century",
    "scheme": "grandcentury",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/grand-century-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "@ammarahmed/react-native-workers",
        {
          "androidNativeModules": false,
          "releaseBundling": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "net.lakesidegames.grandcentury",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Grand Century uses a map library that supports device location. The game does not request or use your location; you can play without granting access."
      }
    },
    "android": {
      "package": "net.lakesidegames.grandcentury",
      "adaptiveIcon": {
        "backgroundColor": "#192d32",
        "foregroundImage": "./assets/grand-century-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/grand-century-icon.png"
    }
  }
}
